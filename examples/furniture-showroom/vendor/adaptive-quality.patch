+/// Interior viewer extension: change tracing quality in place, preserving geometry and radiance caches.
+#[wasm_bindgen(js_name = setQuality)]
+pub fn set_quality(scale: f32, spp: u32) -> Result<(), JsValue> {
+    if !scale.is_finite() || !(0.5..=1.0).contains(&scale) || !(1..=8).contains(&spp) {
+        return Err(failed("quality requires scale 0.5..1 and spp 1..8"));
+    }
+    view(|v| {
+        let refine = scale == 1.0 && spp > 1;
+        // Discard low-resolution screen history once, while retaining world radiance/BVH caches.
+        if refine && !v.core.stationary_refinement { v.core.reset_history(); }
+        v.core.stationary_refinement = refine;
+        v.core.set_scale(scale); v.spp = spp; Ok(())
+    })
+}
+
+/// Avoid queuing expensive refinement frames ahead of interactive input.
+#[wasm_bindgen(js_name = frameReady)]
+pub fn frame_ready() -> Result<bool, JsValue> {
+    view(|v| Ok(!v.pending.load(std::sync::atomic::Ordering::Relaxed)))
+}
+
+/// Scene edits invalidate cached illumination; camera movement does not.
+#[wasm_bindgen(js_name = invalidateLighting)]
+pub fn invalidate_lighting() -> Result<(), JsValue> {
+    view(|v| { v.core.invalidate_radiance_cache(); Ok(()) })
+}
