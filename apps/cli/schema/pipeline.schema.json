{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "stack3 pipeline v1",
  "$ref": "#/$defs/manifest",
  "required": ["version"],
  "$defs": {
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": { "const": 1 },
        "includes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
        "values": { "type": "object", "description": "Defaults used by quoted .Values references." },
        "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } }
      }
    },
    "text": { "type": "string", "pattern": "\\S" },
    "template": {
      "type": "string",
      "pattern": "\\{\\{\\s*\\.Values\\.[\\w-]+(?:\\.[\\w-]+)*\\s*\\}\\}"
    },
    "scalarReference": {
      "type": "string",
      "pattern": "^\\s*\\{\\{\\s*\\.Values\\.[\\w-]+(?:\\.[\\w-]+)*\\s*\\}\\}\\s*$"
    },
    "id": { "anyOf": [{ "type": "string", "pattern": "^[A-Za-z0-9_-]+$" }, { "$ref": "#/$defs/template" }] },
    "bool": { "anyOf": [{ "type": "boolean" }, { "$ref": "#/$defs/scalarReference" }] },
    "number": { "anyOf": [{ "type": "number" }, { "$ref": "#/$defs/scalarReference" }] },
    "positive": { "anyOf": [{ "type": "number", "exclusiveMinimum": 0 }, { "$ref": "#/$defs/scalarReference" }] },
    "xyz": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/number" } },
    "bounds": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "$ref": "#/$defs/xyz" } },
    "triangleBudget": { "anyOf": [{ "type": "integer", "minimum": 4, "maximum": 9007199254740991 }, { "$ref": "#/$defs/scalarReference" }] },
    "lodBevel": {
      "type": "object", "additionalProperties": false, "required": ["preTriangleBudget", "rims"],
      "description": "Run QEM before beveling selected circular rims. The export must fit finish.triangleBudget.",
      "properties": {
        "preTriangleBudget": { "$ref": "#/$defs/triangleBudget" },
        "rims": { "type": "array", "minItems": 1, "items": {
          "type": "object", "additionalProperties": false,
          "required": ["id", "axis", "center", "radius", "radialTolerance", "axialTolerance"],
          "properties": {
            "id": { "$ref": "#/$defs/text" },
            "axis": { "enum": ["x", "y", "z"] },
            "center": { "$ref": "#/$defs/xyz" },
            "radius": { "$ref": "#/$defs/positive" },
            "radialTolerance": { "$ref": "#/$defs/positive" },
            "axialTolerance": { "$ref": "#/$defs/positive" }
          }
        } }
      }
    },
    "regularization": {
      "type": "object", "additionalProperties": false, "required": ["tolerance", "features"],
      "properties": {
        "tolerance": { "$ref": "#/$defs/positive", "description": "Surface selection and fitting tolerance in stack scene units." },
        "features": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["id", "type"],
            "properties": {
              "id": { "$ref": "#/$defs/text" },
              "type": { "enum": ["plane", "circle", "cylinder", "polygon"] },
              "normal": { "$ref": "#/$defs/xyz" },
              "bounds": { "$ref": "#/$defs/bounds" },
              "center": { "$ref": "#/$defs/xyz" },
              "axis": { "$ref": "#/$defs/xyz" },
              "radius": { "$ref": "#/$defs/positive" },
              "corners": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/xyz" } }
            },
            "allOf": [
              { "if": { "properties": { "type": { "const": "plane" } } }, "then": { "required": ["normal", "bounds"], "propertyNames": { "enum": ["id", "type", "normal", "bounds"] } } },
              { "if": { "properties": { "type": { "const": "circle" } } }, "then": { "required": ["center", "axis", "radius"], "propertyNames": { "enum": ["id", "type", "center", "axis", "radius"] } } },
              { "if": { "properties": { "type": { "const": "cylinder" } } }, "then": { "required": ["center", "axis", "radius", "bounds"], "propertyNames": { "enum": ["id", "type", "center", "axis", "radius", "bounds"] } } },
              { "if": { "properties": { "type": { "const": "polygon" } } }, "then": { "required": ["corners"], "propertyNames": { "enum": ["id", "type", "corners"] } } }
            ]
          }
        },
        "relations": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["type", "features"],
            "properties": {
              "type": { "enum": ["parallel", "perpendicular", "coplanar"] },
              "features": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
            }
          },
          "description": "Optional soft relations between two fitted plane features."
        }
      }
    },
    "method": {
      "enum": [
        "marching-cubes", "surface-nets", "voxel", "section-loft", "heightfield", "smooth-loft", "revolve",
        "extended-mc", "hermite-dc", "mc33", "branch-loft", "path-sweep", "section-network", "greedy", "monotone",
        "signed-distance-dc", "organic"
      ]
    },
    "finish": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fitTolerance": { "$ref": "#/$defs/positive", "description": "Maximum planar fitting residual in scene units." },
        "primitives": { "$ref": "#/$defs/bool", "description": "Fit supported sphere and cylinder regions." },
        "regularization": { "$ref": "#/$defs/regularization" },
        "bevelWidth": { "$ref": "#/$defs/positive", "description": "Bevel offset in scene units." },
        "bevelSegments": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 16 }, { "$ref": "#/$defs/scalarReference" }] },
        "dissolveAngle": { "anyOf": [{ "type": "number", "exclusiveMinimum": 0, "maximum": 45 }, { "$ref": "#/$defs/scalarReference" }] },
        "quadTarget": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 2147483647 }, { "$ref": "#/$defs/scalarReference" }] },
        "triangleBudget": { "$ref": "#/$defs/triangleBudget" },
        "lodBevel": { "$ref": "#/$defs/lodBevel" },
        "aoRadius": { "$ref": "#/$defs/positive", "description": "Vertex ambient occlusion ray distance in scene units." }
      },
      "dependentRequired": { "bevelSegments": ["bevelWidth"], "lodBevel": ["bevelWidth", "triangleBudget"] },
      "if": { "required": ["primitives"], "properties": { "primitives": { "const": true } } },
      "then": { "required": ["fitTolerance"] }
    },
    "node": {
      "type": "object",
      "required": ["id", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "anyOf": [{ "enum": ["load-stack", "reconstruct-stack", "extract-mesh", "write-glb"] }, { "$ref": "#/$defs/template" }] },
        "input": { "$ref": "#/$defs/id", "description": "ID of the input node." },
        "path": { "$ref": "#/$defs/text" },
        "layout": { "$ref": "#/$defs/text", "examples": ["top,left,front,rear", "top,left,front,rear,right,bottom"] },
        "layers": { "anyOf": [{ "type": "integer", "minimum": 8, "maximum": 9007199254740991 }, { "$ref": "#/$defs/scalarReference" }] },
        "resolution": { "anyOf": [{ "type": "integer", "minimum": 16, "maximum": 9007199254740991 }, { "$ref": "#/$defs/scalarReference" }] },
        "height": { "$ref": "#/$defs/positive" },
        "pivot": { "anyOf": [{ "enum": ["ground", "center"] }, { "$ref": "#/$defs/template" }] },
        "profile": { "anyOf": [{ "enum": ["silhouette", "round", "round-base"] }, { "$ref": "#/$defs/template" }] },
        "threshold": { "anyOf": [{ "type": "integer", "minimum": 0, "maximum": 255 }, { "$ref": "#/$defs/scalarReference" }] },
        "method": { "anyOf": [{ "$ref": "#/$defs/method" }, { "$ref": "#/$defs/template" }] },
        "guide": { "$ref": "#/$defs/text" },
        "finish": { "$ref": "#/$defs/finish" },
        "cache": { "$ref": "#/$defs/bool" },
        "lit": { "$ref": "#/$defs/bool" },
        "instances": {
          "type": "array", "minItems": 1,
          "description": "Translation for each GPU instance in glTF XYZ coordinates.",
          "items": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "$ref": "#/$defs/number" } }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "load-stack" } } },
          "then": { "required": ["path"], "propertyNames": { "enum": ["id", "type", "path"] } }
        },
        {
          "if": { "properties": { "type": { "const": "reconstruct-stack" } } },
          "then": {
            "required": ["path"],
            "propertyNames": { "enum": ["id", "type", "path", "layout", "layers", "resolution", "height", "pivot", "profile", "threshold"] },
            "anyOf": [
              { "properties": { "path": { "pattern": "\\.[jJ][sS][oO][nN]$" } }, "not": { "required": ["layout"] } },
              { "properties": { "path": { "pattern": "\\.[pP][nN][gG]$" } }, "required": ["layout"] },
              { "properties": { "path": { "$ref": "#/$defs/template" } } }
            ]
          }
        },
        {
          "if": { "properties": { "type": { "const": "extract-mesh" } } },
          "then": {
            "required": ["input", "method"],
            "propertyNames": { "enum": ["id", "type", "input", "method", "guide", "finish", "cache"] },
            "if": { "properties": { "method": { "enum": ["marching-cubes", "voxel", "surface-nets"] } } },
            "then": {
              "properties": { "guide": false, "finish": { "maxProperties": 0 } }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "write-glb" } } },
          "then": {
            "required": ["input", "path"],
            "propertyNames": { "enum": ["id", "type", "input", "path", "lit", "instances"] },
            "properties": { "path": { "anyOf": [{ "pattern": "\\.[gG][lL][bB]$" }, { "$ref": "#/$defs/template" }] } }
          }
        }
      ]
    }
  }
}
